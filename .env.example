# Copy this file to .env (which is git-ignored) and adjust for your machine.
# The credentials below are local development placeholders, not real secrets.

# Local PostgreSQL/PostGIS connection used by the API and Alembic.
TRANSITPULSE_DATABASE_URL=postgresql+psycopg://transitpulse:transitpulse@localhost:5432/transitpulse

# Official City of Edmonton / ETS static GTFS source. Override for another downloaded feed.
TRANSITPULSE_GTFS_SOURCE_URL=https://gtfs.edmonton.ca/TMGTFSRealTimeWebService/GTFS/GTFS.zip
TRANSITPULSE_GTFS_PROVIDER=City of Edmonton / Edmonton Transit Service

# Official City of Edmonton / ETS GTFS-Realtime protobuf feeds.  These can be
# overridden without changing code if ETS moves an endpoint.
TRANSITPULSE_REALTIME_VEHICLE_POSITIONS_URL=http://gtfs.edmonton.ca/TMGTFSRealTimeWebService/Vehicle/VehiclePositions.pb
TRANSITPULSE_REALTIME_TRIP_UPDATES_URL=http://gtfs.edmonton.ca/TMGTFSRealTimeWebService/TripUpdate/TripUpdates.pb
TRANSITPULSE_REALTIME_ALERTS_URL=http://gtfs.edmonton.ca/TMGTFSRealTimeWebService/Alert/Alerts.pb
TRANSITPULSE_REALTIME_POLL_SECONDS=30
TRANSITPULSE_REALTIME_STALE_AFTER_SECONDS=120

# Centralized operations and recorded-history sufficiency thresholds.
TRANSITPULSE_OPERATIONS_ON_TIME_SECONDS=60
TRANSITPULSE_OPERATIONS_MAJOR_DELAY_SECONDS=300
TRANSITPULSE_OPERATIONS_SEVERE_DELAY_SECONDS=600
TRANSITPULSE_OPERATIONS_BUNCHING_RATIO=0.5
TRANSITPULSE_OPERATIONS_GAP_RATIO=1.75
# Predicted arrivals further ahead than this are not treated as current headways.
TRANSITPULSE_OPERATIONS_PREDICTION_HORIZON_SECONDS=5400
TRANSITPULSE_ANALYTICS_MIN_OBSERVATIONS=30
TRANSITPULSE_ANALYTICS_MIN_DELAY_SAMPLES=10
TRANSITPULSE_ANALYTICS_MIN_COVERAGE_SECONDS=900
TRANSITPULSE_ANALYTICS_MIN_HEADWAY_SAMPLES=2
TRANSITPULSE_ANALYTICS_COMPARISON_MIN_COVERAGE_RATIO=0.75

# Retained for the existing Docker Compose file only; native development does not require Docker.
POSTGRES_DB=transitpulse
POSTGRES_USER=transitpulse
POSTGRES_PASSWORD=transitpulse
POSTGRES_PORT=5432

# Optional variables read from the process environment (not from this file):
#   TRANSITPULSE_TEST_DATABASE_URL  database for the destructive integration tests; its name must end in _test
#   TRANSITPULSE_ARTIFACT_ROOT      alternative location of the generated artifacts/ directory
#   TRANSITPULSE_NO_BROWSER=1       stop START_TRANSITPULSE.bat from opening a browser
#   TRANSITPULSE_CHROME             browser executable for scripts/portfolio_capture
#   API_BASE_URL                    API address the Next.js app proxies /api/* to (default http://localhost:8000)
